# Database
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/ap_control
SQL_ECHO=false

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-secure-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Document Storage (Phase 5A)
STORAGE_ROOT_DIR=backend/storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Gemini AI Invoice Extraction (Phase 5B)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EXTRACTION_PROVIDER=gemini
EXTRACTION_TIMEOUT_SECONDS=30
EXTRACTION_MAX_RETRIES=2
