# ==============================================================================
# APEX PAYABLES — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development. Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required for Backend & Seed Scripts)
# ------------------------------------------------------------------------------
# Local PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ap_control
# For Supabase / Render PostgreSQL, use the URI provided by your dashboard:
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

SQL_ECHO=false

# ------------------------------------------------------------------------------
# 2. CORS & NETWORKING (Required for Production Deployments)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# If omitted, local dev (localhost) and all *.vercel.app preview URLs are allowed by default.
ALLOWED_ORIGINS=http://localhost:5173,https://apex-payables.vercel.app

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (Hackathon Demo & RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 4. DOCUMENT STORAGE
# ------------------------------------------------------------------------------
# Root directory where uploaded invoice PDFs and images are stored
STORAGE_ROOT_DIR=backend/storage
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. GEMINI AI INVOICE EXTRACTION (Phase 5B)
# ------------------------------------------------------------------------------
# Google Gemini API Key: obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# EXTRACTION_PROVIDER can be 'gemini' (uses Gemini API) or 'mock' (offline test fallback)
EXTRACTION_PROVIDER=gemini
EXTRACTION_TIMEOUT_SECONDS=30
EXTRACTION_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 6. FRONTEND DEPLOYMENT VARIABLE (Set in Vercel Environment Variables)
# ------------------------------------------------------------------------------
# VITE_API_URL=https://apex-payables-api.onrender.com
